# Maintainer: Jebin Einstein <jebineinstein at gmail dot com>
pkgname=pique
pkgver=0.1.0
pkgrel=1
pkgdesc='The peek browser for Omarchy and Hyprland: look at a link without paying for it with a tab'
arch=('x86_64' 'aarch64')
url='https://github.com/jebin2/pique'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-webengine'
         'wl-clipboard' 'python' 'hyprland' 'glibc' 'gcc-libs')
optdepends=('python-gobject: peek links and selections in GTK and Qt apps (accessibility bus)'
            'at-spi2-core: peek links and selections in GTK and Qt apps (accessibility bus)')
install=pique.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('354411950f8ef847d4694ec39c3ca1a4778427f3930a0cc11caad4fa9d0e0968')

build() {
  cd "$pkgname-$pkgver"
  mkdir -p build
  cd build
  qmake6 ../pique.pro \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
  cc $CPPFLAGS $CFLAGS -Wall -Wextra $LDFLAGS -o pique-watch ../watch/pique-watch.c
}

check() {
  cd "$pkgname-$pkgver"
  mkdir -p build/tests
  cd build/tests
  qmake6 ../../tests/pique_tests.pro
  make
  QT_QPA_PLATFORM=offscreen ./pique_tests
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/pique "$pkgdir/usr/bin/pique"
  install -Dm755 bin/pique-peek "$pkgdir/usr/bin/pique-peek"
  install -Dm755 bin/pique-peek-host "$pkgdir/usr/bin/pique-peek-host"
  install -Dm755 build/pique-watch "$pkgdir/usr/lib/pique/pique-watch"
  install -Dm755 pkgbuild/pique-hypr "$pkgdir/usr/lib/pique/pique-hypr"
  install -Dm644 pkgbuild/pique.desktop "$pkgdir/usr/share/applications/pique.desktop"
  install -Dm644 pkgbuild/pique.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/pique.svg"
  install -Dm644 browser/manifest.json "$pkgdir/usr/share/pique/extension/manifest.json"
  install -Dm644 browser/peek.js "$pkgdir/usr/share/pique/extension/peek.js"
  install -Dm644 browser/background.js "$pkgdir/usr/share/pique/extension/background.js"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
