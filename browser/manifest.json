{
  "manifest_version": 3,
  "name": "pique",
  "version": "2.2",
  "description": "Peek links and selected text in pique (Alt+Shift+click, Super+Shift+L, Super+Shift+click).",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "peek.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
